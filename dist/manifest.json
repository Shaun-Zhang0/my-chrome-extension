{
  "manifest_version": 3,
  "name": "前端开发助手",
  "description": "前端开发助手",
  "version": "1.0",
  "options_page": "options.html",

  "action": {
    "default_icon": "icon.png",
    "default_title": "前端开发助手",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "js/content_script.js"
      ],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
